@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Protobuf CONFIG)
find_dependency(Boost COMPONENTS headers)

set(DCCL_HAS_THREAD_SUPPORT @DCCL_HAS_THREAD_SUPPORT@)
if(DCCL_HAS_THREAD_SUPPORT)
  find_dependency(Threads)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/dccl-targets.cmake")
